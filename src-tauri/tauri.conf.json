{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiny Note",
  "version": "0.1.12",
  "identifier": "com.tinynote.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tiny Note",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "backgroundColor": "#f5f5f5",
        "decorations": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8080; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'sha256-XCQVNWpNtQyXkkP9MzOZKY1NF7aypWcGx9Q0VA18958='"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "mimeType": "text/markdown",
        "name": "Markdown document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
