{
  "name": "tiny-note",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run check:bundle",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "check:components": "node scripts/check-component-size.mjs",
    "check:styles": "node scripts/check-route-style-scope.mjs",
    "check:contracts": "node scripts/check-command-contract.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:unit && npm run check:contracts && npm run check:components && npm run check:styles && npm run build",
    "measure:startup": "node scripts/measure-release-startup-direct.mjs",
    "release:manifest": "node scripts/update-manifest.mjs",
    "release:check": "node scripts/release-notes.mjs --check-current",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.1",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tiptap/core": "3.30.2",
    "@tiptap/extension-code-block-lowlight": "3.30.2",
    "@tiptap/extension-color": "3.30.2",
    "@tiptap/extension-heading": "3.30.2",
    "@tiptap/extension-highlight": "3.30.2",
    "@tiptap/extension-image": "3.30.2",
    "@tiptap/extension-link": "3.30.2",
    "@tiptap/extension-paragraph": "3.30.2",
    "@tiptap/extension-placeholder": "3.30.2",
    "@tiptap/extension-subscript": "3.30.2",
    "@tiptap/extension-superscript": "3.30.2",
    "@tiptap/extension-table": "3.30.2",
    "@tiptap/extension-table-cell": "3.30.2",
    "@tiptap/extension-table-header": "3.30.2",
    "@tiptap/extension-table-row": "3.30.2",
    "@tiptap/extension-task-item": "3.30.2",
    "@tiptap/extension-task-list": "3.30.2",
    "@tiptap/extension-text-align": "3.30.2",
    "@tiptap/extension-text-style": "3.30.2",
    "@tiptap/extension-typography": "3.30.2",
    "@tiptap/extension-underline": "3.30.2",
    "@tiptap/markdown": "3.30.2",
    "@tiptap/starter-kit": "3.30.2",
    "@tiptap/vue-3": "3.30.2",
    "codemirror": "6.0.2",
    "dompurify": "^3.2.6",
    "highlight.js": "^11.11.1",
    "html2pdf.js": "0.14.0",
    "lowlight": "^3.3.0",
    "lucide-vue-next": "^0.468.0",
    "marked": "^15.0.7",
    "mermaid": "11.17.1",
    "pinia": "^3.0.4",
    "turndown": "^7.2.0",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "@types/node": "~22.20.0",
    "@types/turndown": "~5.0.6",
    "eslint": "^9.18.0",
    "eslint-plugin-vue": "~10.10.0",
    "jsdom": "^25.0.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.68.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.8",
    "vue-eslint-parser": "~10.4.1",
    "vue-tsc": "~3.3.11"
  }
